CREATE TABLE ota_inventory (
    id TEXT NOT NULL PRIMARY KEY,
    ota_product_id TEXT NOT NULL,
    total_quota INTEGER NOT NULL DEFAULT 30,
    booked_quota INTEGER NOT NULL DEFAULT 0,
    remaining_quota INTEGER NOT NULL DEFAULT 30
);

selectByProductId:
SELECT * FROM ota_inventory WHERE ota_product_id = ?;

insertOrUpdateInventory:
INSERT OR REPLACE INTO ota_inventory(id, ota_product_id, total_quota, booked_quota, remaining_quota)
VALUES (?, ?, ?, ?, ?);

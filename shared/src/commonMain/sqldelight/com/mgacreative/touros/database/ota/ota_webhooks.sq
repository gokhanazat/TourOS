CREATE TABLE ota_webhooks (
    id TEXT NOT NULL PRIMARY KEY,
    provider_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    signature TEXT,
    payload TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING',
    retry_count INTEGER NOT NULL DEFAULT 0,
    tenant_id TEXT NOT NULL,
    created_at TEXT NOT NULL
);

selectAllWebhooks:
SELECT * FROM ota_webhooks WHERE tenant_id = ? ORDER BY created_at DESC;

insertWebhook:
INSERT INTO ota_webhooks(id, provider_id, event_type, signature, payload, status, retry_count, tenant_id, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateWebhookStatus:
UPDATE ota_webhooks SET status = ?, retry_count = ? WHERE id = ?;

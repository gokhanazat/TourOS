# TourOS - Tourvisor Actualize Worker ortam değişkenleri ÖRNEĞİ
# Gerçek dosya SUNUCUDA durur, repoya EKLENMEZ:  /etc/touros/tourvisor_actualize.env  (sahibi root, izin 600)
# Değerler, sunucudaki mevcut tourvisor_full_sync.py ile aynı Tourvisor hesabı ve veritabanı bilgileridir.
TV_AUTH_LOGIN=
TV_AUTH_PASS=
DB_HOST=172.18.0.3
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=
# Günlük tek tur sorgu üst sınırı (Tourvisor tarifesi 3000 arama/gün; toplu senkron ~430/gün kullanıyor)
TV_DAILY_CAP=1500
# 0 = gerekirse operatöre sor (önerilen), 2 = asla operatöre sorma (kotaya hiç yansımaz ama fiyat eski olabilir)
TV_ACTUALIZE_REQUEST=0
